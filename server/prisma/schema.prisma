generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(uuid())
  email           String?     @unique
  phone           String      @unique
  passwordHash    String
  role            UserRole    @default(PASSENGER)
  status          UserStatus  @default(ACTIVE)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?
  passengerProfile PassengerProfile?
  driverProfile   DriverProfile?
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  otpVerifications OtpVerification[]
  supportTickets  SupportTicket[]
  notifications   Notification[]
  ratingsGiven    Rating[] @relation("UserRatingsGiven")
  ratingsReceived Rating[] @relation("UserRatingsReceived")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
  SUPPORT
}

model PassengerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String?
  lastName     String?
  avatarUrl    String?
  cityId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  city         City?    @relation(fields: [cityId], references: [id])
  rides       Ride[]   @relation("PassengerRides")
}

model DriverProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  firstName           String?
  lastName            String?
  phone               String
  profilePhotoUrl     String?
  verificationStatus  DriverAccountStatus @default(PENDING_VERIFICATION)
  driverStatus        DriverAvailability  @default(OFFLINE)
  cityId              String?
  vehicleId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id])
  city                City?              @relation(fields: [cityId], references: [id])
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id])
  documents           DriverDocument[]
  rides              Ride[]             @relation("DriverRides")
  ledgerEntries       DriverLedger[]
}

enum DriverAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  BUSY
  SUSPENDED
}

model DriverDocument {
  id        String   @id @default(uuid())
  driverId  String
  type      String
  url       String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    DriverProfile @relation(fields: [driverId], references: [id])
}

model Vehicle {
  id                  String   @id @default(uuid())
  driverProfileId     String?  @unique
  plateNumber         String   @unique
  make                String?
  model               String?
  color               String?
  year                Int?
  vehicleType         String?
  registrationNumber  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  driverProfiles      DriverProfile[]
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  tokenFamily String?
  revoked     Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id         String    @id @default(uuid())
  userId     String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
}

model Ride {
  id              String       @id @default(uuid())
  passengerId     String
  driverId       String?
  status          RideStatus   @default(REQUESTED)
  pickupLat      Float
  pickupLng      Float
  destinationLat  Float
  destinationLng  Float
  paymentMethod  PaymentMethod @default(CASH)
  cityId         String?
  fareId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  passenger      PassengerProfile @relation("PassengerRides", fields: [passengerId], references: [id])
  driver         DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])
  city           City? @relation(fields: [cityId], references: [id])
  fare           Fare? @relation(fields: [fareId], references: [id])
  statusHistory  RideStatusHistory[]
  payments       Payment[]
  ratings        Rating[]
}

enum RideStatus {
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_ARRIVING
  DRIVER_AT_PICKUP
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
  NO_DRIVER_FOUND
}

model RideStatusHistory {
  id          String   @id @default(uuid())
  rideId      String
  previousStatus RideStatus?
  newStatus  RideStatus
  changedBy   String?
  reason      String?
  createdAt   DateTime @default(now())
  ride        Ride     @relation(fields: [rideId], references: [id])
}

model Fare {
  id                 String   @id @default(uuid())
  baseFare           Decimal  @db.Decimal(12, 2)
  perKilometerRate   Decimal  @db.Decimal(12, 2)
  perMinuteRate      Decimal  @db.Decimal(12, 2)
  minimumFare        Decimal  @db.Decimal(12, 2)
  waitingFee         Decimal  @db.Decimal(12, 2)
  cancellationFee    Decimal  @db.Decimal(12, 2)
  serviceFee         Decimal  @db.Decimal(12, 2)
  commissionRate     Decimal  @db.Decimal(5, 2)
  currency           String   @default("ETB")
  cityId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  city               City?    @relation(fields: [cityId], references: [id])
  rides              Ride[]
}

model Payment {
  id                String         @id @default(uuid())
  rideId            String
  paymentMethod     PaymentMethod  @default(CASH)
  providerName      String?
  providerRef       String?
  amount            Decimal        @db.Decimal(12, 2)
  grossAmount       Decimal        @db.Decimal(12, 2)
  commissionAmount  Decimal        @db.Decimal(12, 2)
  driverAmount      Decimal        @db.Decimal(12, 2)
  status            PaymentState   @default(PENDING)
  currency          String         @default("ETB")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  ride              Ride           @relation(fields: [rideId], references: [id])
  transactions      PaymentTransaction[]
}

enum PaymentMethod {
  CASH
  TELEBIRR
  MOBILE_MONEY
  BANK
  CARD
}

enum PaymentState {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

model PaymentTransaction {
  id                 String   @id @default(uuid())
  paymentId          String
  type               String
  providerRef        String?
  amount             Decimal  @db.Decimal(12, 2)
  status             String   @default("PENDING")
  metadata           Json?
  createdAt          DateTime @default(now())
  payment            Payment   @relation(fields: [paymentId], references: [id])
}

model DriverLedger {
  id              String             @id @default(uuid())
  driverId        String
  transactionType LedgerTransactionType
  amount          Decimal            @db.Decimal(12, 2)
  balanceAfter    Decimal            @db.Decimal(12, 2)
  reference       String
  rideId          String?
  paymentId       String?
  createdAt       DateTime           @default(now())
  driver          DriverProfile      @relation(fields: [driverId], references: [id])
}

enum LedgerTransactionType {
  RIDE_EARNING
  PLATFORM_COMMISSION
  CASH_COMMISSION_DUE
  PAYMENT_SETTLEMENT
  ADJUSTMENT
  REFUND
  PENALTY
  BONUS
}

model Commission {
  id            String   @id @default(uuid())
  driverId      String?
  rideId        String?
  amount        Decimal  @db.Decimal(12, 2)
  rate          Decimal  @db.Decimal(5, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Rating {
  id         String   @id @default(uuid())
  rideId     String
  raterId    String
  rateeId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  ride       Ride     @relation(fields: [rideId], references: [id])
  rater      User     @relation("UserRatingsGiven", fields: [raterId], references: [id])
  ratee      User     @relation("UserRatingsReceived", fields: [rateeId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String
  metadata   Json?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  category    String
  subject     String
  message     String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model AdminSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model City {
  id           String   @id @default(uuid())
  name         String
  countryCode  String   @default("ET")
  timezone     String   @default("Africa/Addis_Ababa")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  serviceAreas ServiceArea[]
  rides        Ride[]
  passengerProfiles PassengerProfile[]
  driverProfiles    DriverProfile[]
  fares        Fare[]
}

model ServiceArea {
  id          String   @id @default(uuid())
  cityId      String
  name        String
  polygonJson String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  city        City     @relation(fields: [cityId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
